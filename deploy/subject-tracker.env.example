# Copy to /etc/subject-tracker.env and fill in a real secret.
# Generate the secret with:  python3 -c 'import secrets; print(secrets.token_hex(32))'

SUBJECT_TRACKER_ENV=prod
SUBJECT_TRACKER_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Absolute SQLite path on the VM's persistent boot volume. Note the FOUR slashes
# (sqlite:/// + /absolute/path). This directory must exist and be writable by the
# service user.
SUBJECT_TRACKER_DB=sqlite:////home/ubuntu/subject-tracker-data/app.db

# Set to 1 only once HTTPS is terminated by nginx (marks session cookies Secure).
SUBJECT_TRACKER_HTTPS=1
